# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required).
# On Vercel, provision a database at https://vercel.com/storage/postgres
# or use Neon (https://neon.tech) / Supabase (https://supabase.com).
DATABASE_URL=postgresql://user:password@host:5432/nextstop

# ── Auth ──────────────────────────────────────────────────────────────────────
# Random secret used to sign express-session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_random_32_char_string

# ── Mapbox ────────────────────────────────────────────────────────────────────
# Public Mapbox token — used at BUILD TIME by Vite (prefix VITE_ required).
# Get yours at https://account.mapbox.com
VITE_MAPBOX_TOKEN=pk.eyJ1...
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# ── OSRM (optional) ──────────────────────────────────────────────────────────
# OSRM route-matching service URL.
# Leave blank to disable road-snapping (raw GPS will be used instead).
# Public demo: http://router.project-osrm.org
# Self-hosted: http://your-server:5000
OSRM_BASE_URL=http://router.project-osrm.org

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
